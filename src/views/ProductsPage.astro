---
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import ProductCard from '../components/ProductCard.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'
import CategoryIcon from '../components/CategoryIcon.astro'
import { categories } from '../data/site'
import { t, type Lang } from '../lib/i18n'
import { getProducts } from '../lib/products'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const products = await getProducts()
const groups = categories
  .map((category) => ({
    category,
    items: products.filter((p) => p.data.category === category.id),
  }))
  .filter((group) => group.items.length > 0)

const copy = {
  en: {
    title: 'Products | tai – Pride of Africa',
    description:
      'Phone chargers, cables, earphones and accessories from tai. Ask for prices and wholesale supply on WhatsApp.',
    eyebrow: 'Catalogue',
    heading: 'Our products',
    intro:
      'Prices are shared on request. Send us the model code on WhatsApp for retail or wholesale prices.',
    jump: 'Jump to category',
  },
  sw: {
    title: 'Bidhaa | tai – Pride of Africa',
    description:
      'Chaja, nyaya, earphone na vifaa vya simu kutoka tai. Uliza bei na usambazaji wa jumla kupitia WhatsApp.',
    eyebrow: 'Katalogi',
    heading: 'Bidhaa zetu',
    intro:
      'Bei hutolewa kwa ombi. Tutumie namba ya modeli WhatsApp upate bei ya rejareja au ya jumla.',
    jump: 'Nenda kwenye kundi',
  },
}[lang]
---

<Base lang={lang} title={copy.title} description={copy.description}>
  <PageHero eyebrow={copy.eyebrow} title={copy.heading} intro={copy.intro}>
    <form class="search" role="search" data-search-form onsubmit="return false">
      <label class="visually-hidden" for="product-search">{t(lang, 'search.label')}</label>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
        <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
      </svg>
      <input
        id="product-search"
        type="search"
        autocomplete="off"
        placeholder={t(lang, 'search.placeholder')}
        data-search-input
      />
    </form>
    <nav class="jump" aria-label={copy.jump}>
      <ul>
        <li>
          <a href="#catalogue" data-filter="all" aria-current="true">{t(lang, 'search.all')}</a>
        </li>
        {
          groups.map(({ category }) => (
            <li>
              <a href={`#${category.id}`} data-filter={category.id}>
                <CategoryIcon id={category.id} />
                {category[lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="result-count" aria-live="polite" data-result-count>
      {t(lang, 'search.count', { count: products.length })}
    </p>
  </PageHero>

  <div class="container section" id="catalogue">
    {
      groups.map(({ category, items }, groupIndex) => (
        <section class="group" id={category.id} aria-labelledby={`${category.id}-title`} data-group={category.id}>
          <div class="group__head">
            <span class="group__icon">
              <CategoryIcon id={category.id} />
            </span>
            <h2 id={`${category.id}-title`}>{category[lang]}</h2>
            <span class="group__count" data-group-count>{items.length}</span>
          </div>
          <div class="grid">
            {items.map((product, i) => (
              <ProductCard product={product} lang={lang} eager={groupIndex === 0 && i < 2} />
            ))}
          </div>
        </section>
      ))
    }

    <div class="empty" data-search-empty hidden>
      <p>{t(lang, 'search.none')}</p>
      <WhatsAppButton message={t(lang, 'wa.general')} label={t(lang, 'search.noneAsk')} />
    </div>
  </div>

  <script is:inline define:vars={{ countTemplate: t(lang, 'search.count', { count: '{count}' }) }}>
    const input = document.querySelector('[data-search-input]')
    const cards = [...document.querySelectorAll('#catalogue [data-product-card]')]
    const groups = [...document.querySelectorAll('[data-group]')]
    const chips = [...document.querySelectorAll('[data-filter]')]
    const empty = document.querySelector('[data-search-empty]')
    const count = document.querySelector('[data-result-count]')
    let category = 'all'

    const apply = () => {
      const words = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean)
      let shown = 0
      cards.forEach((card) => {
        const text = card.dataset.search || ''
        const match =
          (category === 'all' || card.dataset.category === category) &&
          words.every((w) => text.includes(w) || text.includes(w.replace('-', '')))
        card.hidden = !match
        if (match) shown++
      })
      groups.forEach((group) => {
        const visible = group.querySelectorAll('[data-product-card]:not([hidden])').length
        group.hidden = visible === 0
        const c = group.querySelector('[data-group-count]')
        if (c) c.textContent = String(visible)
      })
      empty.hidden = shown > 0
      count.textContent = countTemplate.replace('{count}', shown)
    }

    input.addEventListener('input', apply)
    chips.forEach((chip) =>
      chip.addEventListener('click', (event) => {
        event.preventDefault()
        category = chip.dataset.filter
        chips.forEach((c) => c.setAttribute('aria-current', String(c === chip)))
        apply()
        document.getElementById('catalogue').scrollIntoView({ behavior: 'smooth', block: 'start' })
      }),
    )
    // Search from the address bar, e.g. /products/?q=65W
    const q = new URLSearchParams(location.search).get('q')
    if (q) input.value = q
    apply()
  </script>
</Base>

<style>
  .jump ul {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--white);
    font-weight: 700;
    text-decoration: none;
  }

  .jump a:hover {
    border-color: var(--lime-bright);
    color: var(--lime-bright);
  }

  .jump a[aria-current='true'] {
    background: var(--lime-bright);
    border-color: var(--lime-bright);
    color: var(--ink);
  }

  .jump a[aria-current='true'] :global(svg) {
    color: var(--ink);
  }

  .search {
    position: relative;
    max-width: 40rem;
    margin-top: 0.5rem;
  }

  .search svg {
    position: absolute;
    left: 1.2rem;
    top: 50%;
    width: 22px;
    height: 22px;
    transform: translateY(-50%);
    color: var(--ink);
    pointer-events: none;
  }

  .search input {
    width: 100%;
    min-height: 60px;
    padding: 0 1.25rem 0 3.4rem;
    border-radius: 999px;
    border: 2px solid var(--lime-bright);
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .search input::placeholder {
    color: #4a5e43;
    font-weight: 500;
  }

  .search input:focus-visible {
    outline: 3px solid var(--amber);
    outline-offset: 3px;
  }

  .result-count {
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-weight: 600;
  }

  .empty {
    padding: 3rem 1.5rem;
    border: 2px dashed var(--border);
    border-radius: var(--radius);
    text-align: center;
  }

  .empty p {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .group[hidden],
  .empty[hidden] {
    display: none;
  }

  .jump :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--lime-bright);
  }

  .group + .group {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
  }

  .group {
    scroll-margin-top: 90px;
  }

  .group__head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.75rem;
  }

  .group__head h2 {
    margin: 0;
    font-size: clamp(1.9rem, 5vw, 3rem);
  }

  .group__icon {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--lime-bright);
    color: var(--ink);
    flex: none;
  }

  .group__icon :global(svg) {
    width: 28px;
    height: 28px;
  }

  .group__count {
    display: inline-grid;
    place-items: center;
    min-width: 34px;
    height: 34px;
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--lime-bright);
    font-weight: 800;
    font-size: 0.9rem;
  }
</style>
