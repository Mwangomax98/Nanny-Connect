---
import { Picture } from 'astro:assets'
import Base from '../layouts/Base.astro'
import CategoryIcon from '../components/CategoryIcon.astro'
import ProductCard from '../components/ProductCard.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'
import { categories, site } from '../data/site'
import { localePath, t, type Lang } from '../lib/i18n'
import { getProducts } from '../lib/products'
import { storeSchema } from '../lib/schema'
import { whatsappLink } from '../lib/whatsapp'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const products = await getProducts()
const featured = products.filter((p) => p.data.featured).slice(0, 6)
const categoriesWithProducts = new Set(products.map((p) => p.data.category))

// Three product photos for the hero collage.
const heroCodes = ['T-05', 'T-021', 'T-07']
const heroProducts = heroCodes
  .map((code) => products.find((p) => p.data.code === code))
  .filter((p) => p !== undefined)
  .concat(featured)
  .filter((p, i, all) => all.indexOf(p) === i)
  .slice(0, 3)

const copy = {
  en: {
    title: 'tai – Pride of Africa | Phone chargers, cables & accessories in Tanzania',
    description:
      'tai supplies phone chargers, cables, batteries, earphones and hair clippers from Dar es Salaam to shoppers, retailers, wholesalers and barbershops across East Africa.',
    eyebrow: 'tai · Pride of Africa',
    heading: ['Charge fast.', 'Stay connected.'],
    intro:
      'Chargers, cables, batteries, earphones and grooming tools for everyday life, supplied from Dar es Salaam to shops across East Africa.',
    badges: ['⚡ Fast charging', '365-day warranty', 'Retail & wholesale'],
    stats: [
      { value: '365', label: 'days warranty on selected chargers' },
      { value: '7', label: 'product ranges, one trusted brand' },
      { value: 'EA', label: 'retail and wholesale across East Africa' },
    ],
    ticker: ['Chargers', 'Cables', 'Batteries', 'Earphones', 'Memory cards', 'USB drives', 'Hair clippers', 'Phone holders'],
    featuredEyebrow: 'Best sellers',
    featuredTitle: 'Built to charge. Built to last.',
    featuredText: 'Send the model code on WhatsApp and we reply with price and stock.',
    allProducts: 'All products',
    rangeEyebrow: 'Our range',
    rangeTitle: 'Everything a phone needs.',
    rangeText: 'One supplier for the accessories your customers ask for every day.',
    rangeAsk: 'Ask on WhatsApp',
    rangeSee: 'See products',
    whoEyebrow: 'Who we serve',
    whoTitle: 'Made for the people who keep Africa connected.',
    who: [
      {
        title: 'Shoppers',
        text: 'Reliable accessories at fair prices, with a warranty you can count on.',
      },
      {
        title: 'Retailers & wholesalers',
        text: 'Steady supply of fast-moving accessories for your shop or distribution network.',
      },
      {
        title: 'Barbershops',
        text: 'Hair clippers and trimmers built for professional, everyday use.',
      },
    ],
    stockistTitle: 'Stock tai in your shop.',
    stockistText:
      'Join retailers, wholesalers and distributors across Tanzania and East Africa. Wholesale prices on request.',
    founderQuote:
      'I set out to build a trusted African brand that delivers quality, reliability and value, and grows together with the shops that sell it.',
    founderRole: 'Founder, tai – Pride of Africa',
  },
  sw: {
    title: 'tai – Pride of Africa | Chaja, nyaya na vifaa vya simu Tanzania',
    description:
      'tai inasambaza chaja, nyaya, betri, earphone na mashine za kunyolea kutoka Dar es Salaam kwa wateja, wauzaji wa rejareja, wa jumla na vinyozi Afrika Mashariki.',
    eyebrow: 'tai · Fahari ya Afrika',
    heading: ['Chaji haraka.', 'Endelea kuunganishwa.'],
    intro:
      'Chaja, nyaya, betri, earphone na vifaa vya kunyolea kwa maisha ya kila siku, tunasambaza kutoka Dar es Salaam kwa maduka Afrika Mashariki.',
    badges: ['⚡ Chaji ya haraka', 'Dhamana siku 365', 'Rejareja na jumla'],
    stats: [
      { value: '365', label: 'siku za dhamana kwa chaja teule' },
      { value: '7', label: 'aina za bidhaa, chapa moja ya kuaminika' },
      { value: 'EA', label: 'rejareja na jumla Afrika Mashariki' },
    ],
    ticker: ['Chaja', 'Nyaya', 'Betri', 'Earphone', 'Memory card', 'Flash', 'Mashine za kunyolea', 'Vishikio vya simu'],
    featuredEyebrow: 'Zinazouzwa zaidi',
    featuredTitle: 'Imara kuchaji. Imara kudumu.',
    featuredText: 'Tuma namba ya modeli WhatsApp, tutakujibu na bei na upatikanaji.',
    allProducts: 'Bidhaa zote',
    rangeEyebrow: 'Bidhaa zetu',
    rangeTitle: 'Kila kitu simu inahitaji.',
    rangeText: 'Msambazaji mmoja wa vifaa ambavyo wateja wako huomba kila siku.',
    rangeAsk: 'Uliza WhatsApp',
    rangeSee: 'Tazama bidhaa',
    whoEyebrow: 'Tunaowahudumia',
    whoTitle: 'Kwa wanaoifanya Afrika iendelee kuunganishwa.',
    who: [
      {
        title: 'Wateja',
        text: 'Vifaa vya kuaminika kwa bei nzuri, pamoja na dhamana unayoweza kuitegemea.',
      },
      {
        title: 'Wauzaji wa rejareja na jumla',
        text: 'Upatikanaji wa uhakika wa bidhaa zinazouzika haraka kwa duka au mtandao wako.',
      },
      {
        title: 'Vinyozi',
        text: 'Mashine za kunyolea na kupunguza nywele kwa matumizi ya kitaalamu kila siku.',
      },
    ],
    stockistTitle: 'Uza tai dukani kwako.',
    stockistText:
      'Ungana na wauzaji wa rejareja, wa jumla na wasambazaji Tanzania na Afrika Mashariki. Bei ya jumla kwa ombi.',
    founderQuote:
      'Nilianza kujenga chapa ya Kiafrika inayoaminika, inayoleta ubora, uhakika na thamani, na inayokua pamoja na maduka yanayoiuza.',
    founderRole: 'Mwanzilishi, tai – Pride of Africa',
  },
}[lang]
---

<Base lang={lang} title={copy.title} description={copy.description} jsonLd={storeSchema(Astro.site!)}>
  <!-- HERO -->
  <section class="hero chevrons">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>
          <span>{copy.heading[0]}</span>
          <span class="hero__line2">{copy.heading[1]}</span>
        </h1>
        <p class="hero__intro">{copy.intro}</p>
        <div class="btn-row">
          <WhatsAppButton message={t(lang, 'wa.general')} label={t(lang, 'cta.whatsapp')} />
          <a class="btn btn--outline" href={localePath(lang, '/products/')}>
            {t(lang, 'cta.viewProducts')}
          </a>
        </div>
      </div>

      <div class="stage" aria-hidden="true">
        <div class="stage__disc">
          <span class="eagle-mark stage__eagle"></span>
        </div>
        {
          heroProducts.map((product, i) => (
            <div class={`stage__item stage__item--${i + 1}`}>
              <Picture
                class="float-shadow"
                src={product.data.images[0]}
                alt=""
                formats={['avif', 'webp']}
                fallbackFormat="png"
                widths={[240, 360, 520]}
                sizes="(min-width: 60rem) 16rem, 40vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
            </div>
          ))
        }
        {copy.badges.map((badge, i) => <span class={`badge badge--${i + 1}`}>{badge}</span>)}
      </div>
    </div>
  </section>

  <!-- TICKER -->
  <div class="ticker on-dark" aria-hidden="true">
    <div class="ticker__track">
      {
        [0, 1].map(() => (
          <ul>
            {copy.ticker.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <!-- STATS -->
  <section class="stats on-dark" aria-label="tai">
    <div class="container stats__grid">
      {
        copy.stats.map((stat, i) => (
          <div class="stat" data-reveal style={`--delay:${i * 0.1}s`}>
            <p class="stat__value">{stat.value}</p>
            <p class="stat__label">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- FEATURED -->
  <section class="section" aria-labelledby="featured-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">{copy.featuredEyebrow}</p>
          <h2 id="featured-title">{copy.featuredTitle}</h2>
        </div>
        <p>{copy.featuredText}</p>
      </div>
      <div class="grid">
        {featured.map((product) => <ProductCard product={product} lang={lang} />)}
      </div>
      <p class="more">
        <a class="btn btn--ink" href={localePath(lang, '/products/')}>{copy.allProducts} →</a>
      </p>
    </div>
  </section>

  <!-- RANGE -->
  <section class="section section--ink chevrons" aria-labelledby="range-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">{copy.rangeEyebrow}</p>
          <h2 id="range-title">{copy.rangeTitle}</h2>
        </div>
        <p>{copy.rangeText}</p>
      </div>
      <ul class="range">
        {
          categories.map((category, index) => {
            const hasProducts = categoriesWithProducts.has(category.id)
            const href = hasProducts
              ? localePath(lang, `/products/#${category.id}`)
              : whatsappLink(`${t(lang, 'wa.general')} (${category[lang]})`)
            return (
              <li data-reveal style={`--delay:${(index % 4) * 0.07}s`}>
                <a
                  class="tile"
                  href={href}
                  target={hasProducts ? undefined : '_blank'}
                  rel={hasProducts ? undefined : 'noopener'}
                >
                  <span class="tile__icon">
                    <CategoryIcon id={category.id} />
                  </span>
                  <span class="tile__name">{category[lang]}</span>
                  <span class="tile__cta">{hasProducts ? copy.rangeSee : copy.rangeAsk} →</span>
                </a>
              </li>
            )
          })
        }
      </ul>
    </div>
  </section>

  <!-- WHO WE SERVE -->
  <section class="section" aria-labelledby="who-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">{copy.whoEyebrow}</p>
          <h2 id="who-title">{copy.whoTitle}</h2>
        </div>
      </div>
      <ol class="who">
        {
          copy.who.map((item, i) => (
            <li class="who__item" data-reveal style={`--delay:${i * 0.1}s`}>
              <span class="who__num" aria-hidden="true">
                0{i + 1}
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- STOCKIST -->
  <section class="section section--lime chevrons" aria-labelledby="stockist-title">
    <div class="container stockist" data-reveal>
      <div>
        <h2 id="stockist-title">{copy.stockistTitle}</h2>
        <p class="lead">{copy.stockistText}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--ink" href={localePath(lang, '/wholesale/')}>
          {t(lang, 'cta.becomeStockist')} →
        </a>
      </div>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="section" aria-label={copy.founderRole}>
    <div class="container">
      <figure class="quote" data-reveal>
        <span class="quote__mark" aria-hidden="true">“</span>
        <blockquote>
          <p>{copy.founderQuote}</p>
        </blockquote>
        <figcaption>
          <strong>{site.founder}</strong>
          <span>{copy.founderRole}</span>
        </figcaption>
      </figure>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    background: var(--lime);
    color: var(--ink);
    --focus: var(--ink);
  }

  .hero .eyebrow::before {
    background: var(--ink);
  }

  .hero__grid {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 9vw, 6.5rem) clamp(3.5rem, 9vw, 6.5rem);
    align-items: center;
  }

  .hero h1 {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
  }

  .hero__line2 {
    align-self: flex-start;
    margin-top: 0.12em;
    padding: 0.02em 0.18em 0.1em;
    border-radius: 0.12em;
    background: var(--ink);
    color: var(--lime-bright);
    transform: rotate(-1.5deg);
    transform-origin: left center;
  }

  .hero__intro {
    font-size: clamp(1.1rem, 2.4vw, 1.3rem);
    max-width: 34rem;
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .hero .btn--outline {
    border-color: var(--ink);
  }

  .stage {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    aspect-ratio: 1;
  }

  .stage__disc {
    position: absolute;
    inset: 7%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #1c3a12 0%, var(--ink) 68%);
    box-shadow:
      0 0 0 14px rgb(9 22 6 / 0.12),
      0 0 0 28px rgb(9 22 6 / 0.06),
      0 40px 80px -30px rgb(9 22 6 / 0.8);
    overflow: hidden;
  }

  .stage__eagle {
    width: 78%;
    left: 11%;
    top: 14%;
    color: var(--lime-bright);
    opacity: 0.1;
  }

  .stage__item {
    position: absolute;
    animation: float 7s ease-in-out infinite;
    transform: rotate(var(--r, 0deg));
  }

  .stage__item :global(img) {
    width: 100%;
    height: auto;
  }

  .stage__item--1 {
    width: 40%;
    left: 30%;
    top: 12%;
    z-index: 3;
    --r: -3deg;
  }

  .stage__item--2 {
    width: 34%;
    left: 4%;
    top: 34%;
    z-index: 2;
    --r: -12deg;
    animation-delay: -2.3s;
  }

  .stage__item--3 {
    width: 38%;
    right: 2%;
    top: 38%;
    z-index: 2;
    --r: 10deg;
    animation-delay: -4.6s;
  }

  @keyframes float {
    50% {
      transform: translateY(-14px) rotate(var(--r, 0deg));
    }
  }

  .badge {
    position: absolute;
    z-index: 4;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    font-weight: 800;
    font-size: clamp(0.75rem, 2.4vw, 0.95rem);
    letter-spacing: -0.01em;
    white-space: nowrap;
    box-shadow: 0 14px 30px -12px rgb(9 22 6 / 0.6);
  }

  .badge--1 {
    top: 6%;
    left: 0;
    background: var(--white);
    color: var(--ink);
    transform: rotate(-6deg);
  }

  .badge--2 {
    top: 18%;
    right: 0;
    background: var(--amber);
    color: var(--ink);
    transform: rotate(5deg);
  }

  .badge--3 {
    bottom: 6%;
    left: 50%;
    background: var(--ink);
    color: var(--lime-bright);
    transform: translateX(-50%) rotate(-2deg);
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 3rem;
    }
  }

  /* ---------- Ticker ---------- */
  .ticker {
    overflow: hidden;
    padding-block: 1.1rem;
    border-block: 1px solid #1d3516;
  }

  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker 40s linear infinite;
  }

  .ticker ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ticker li {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.3rem, 3.5vw, 2rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-inline: 1.2rem;
  }

  .ticker li::after {
    content: '✦';
    margin-left: 2.4rem;
    color: var(--lime-bright);
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- Stats ---------- */
  .stats {
    padding-bottom: 0.5rem;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .stat {
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
  }

  .stat:last-child {
    border-bottom: 0;
  }

  .stat__value {
    margin: 0 0 0.25rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.2rem, 9vw, 4.8rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--lime-bright);
  }

  .stat__label {
    margin: 0;
    font-weight: 600;
    color: var(--muted);
    max-width: 16rem;
  }

  @media (min-width: 46rem) {
    .stat {
      border-bottom: 0;
      border-right: 1px solid var(--border);
      padding: 2.5rem 2rem;
    }

    .stat:first-child {
      padding-left: 0;
    }

    .stat:last-child {
      border-right: 0;
    }
  }

  .more {
    margin: 2.5rem 0 0;
  }

  /* ---------- Range tiles ---------- */
  .range {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--white);
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .tile:hover {
    transform: translateY(-4px);
    border-color: var(--lime-bright);
    background: #14300e;
  }

  .tile__icon {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--lime-bright);
    color: var(--ink);
  }

  .tile__icon :global(svg) {
    width: 30px;
    height: 30px;
  }

  .tile__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .tile__cta {
    margin-top: auto;
    color: var(--lime-bright);
    font-weight: 700;
    font-size: 0.95rem;
  }

  /* ---------- Who we serve ---------- */
  .who {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .who__item {
    position: relative;
    padding: 2rem 1.6rem 1.6rem;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .who__item::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    background: var(--lime);
  }

  .who__num {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 4rem;
    line-height: 1;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 2px var(--link);
    margin-bottom: 1rem;
  }

  .who__item h3 {
    font-size: 1.6rem;
  }

  .who__item p {
    margin: 0;
    color: var(--muted);
  }

  /* ---------- Stockist ---------- */
  .stockist {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  .stockist h2 {
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    max-width: 12ch;
  }

  .stockist .lead {
    margin: 0;
  }

  @media (min-width: 60rem) {
    .stockist {
      grid-template-columns: 1fr auto;
    }
  }

  /* ---------- Founder quote ---------- */
  .quote {
    position: relative;
    margin: 0;
    max-width: 58rem;
  }

  .quote__mark {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 9rem;
    line-height: 0.6;
    color: var(--lime);
    margin-bottom: 0.5rem;
  }

  .quote blockquote {
    margin: 0 0 1.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 4.5vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .quote blockquote p {
    margin: 0;
  }

  .quote figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-left: 1rem;
    border-left: 4px solid var(--lime);
  }

  .quote figcaption span {
    color: var(--muted);
  }
</style>
