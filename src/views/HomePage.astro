---
import Base from '../layouts/Base.astro'
import ProductCard from '../components/ProductCard.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'
import { categories, site } from '../data/site'
import { localePath, t, type Lang } from '../lib/i18n'
import { getProducts } from '../lib/products'
import { storeSchema } from '../lib/schema'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const products = await getProducts()
const featured = products.filter((p) => p.data.featured).slice(0, 6)
const categoriesWithProducts = new Set(products.map((p) => p.data.category))

const copy = {
  en: {
    title: 'tai – Pride of Africa | Phone chargers, cables & accessories in Tanzania',
    description:
      'tai supplies phone chargers, cables, batteries, memory cards and hair clippers from Dar es Salaam to shoppers, retailers, wholesalers and barbershops across East Africa.',
    eyebrow: 'Pride of Africa',
    heading: 'Phone accessories you can rely on.',
    intro:
      'Chargers, cables, batteries and more, supplied from Dar es Salaam to shoppers, shops, wholesalers and barbershops across East Africa.',
    trust: ['Up to 365 days warranty', 'Based in Ilala, Dar es Salaam', 'Retail and wholesale'],
    featuredTitle: 'Popular products',
    rangeTitle: 'What we supply',
    rangeIntro: 'Everyday essentials for mobile phone users and businesses.',
    rangeAsk: 'Ask us on WhatsApp',
    whoTitle: 'Who we serve',
    who: [
      {
        title: 'Shoppers',
        text: 'Reliable accessories at fair prices, with a warranty you can count on.',
      },
      {
        title: 'Retailers & wholesalers',
        text: 'Steady supply of fast-moving accessories for your shop or distribution network.',
      },
      {
        title: 'Barbershops',
        text: 'Hair clippers and trimmers for professional, everyday use.',
      },
    ],
    stockistTitle: 'Sell tai in your shop',
    stockistText:
      'We work with retailers, wholesalers and distributors across Tanzania and East Africa. Get wholesale prices on WhatsApp.',
    founderQuote:
      'My vision in establishing tai was to build a trusted brand that delivers quality, reliability, and value in mobile phone accessories and electronic products.',
    founderRole: 'Founder, tai – Pride of Africa',
  },
  sw: {
    title: 'tai – Pride of Africa | Chaja, nyaya na vifaa vya simu Tanzania',
    description:
      'tai inasambaza chaja, nyaya, betri, memory card na mashine za kunyolea kutoka Dar es Salaam kwa wateja, wauzaji wa rejareja, wa jumla na vinyozi Afrika Mashariki.',
    eyebrow: 'Fahari ya Afrika',
    heading: 'Vifaa vya simu unavyoweza kuviamini.',
    intro:
      'Chaja, nyaya, betri na zaidi, tunasambaza kutoka Dar es Salaam kwa wateja, maduka, wauzaji wa jumla na vinyozi Afrika Mashariki.',
    trust: ['Dhamana hadi siku 365', 'Tupo Ilala, Dar es Salaam', 'Rejareja na jumla'],
    featuredTitle: 'Bidhaa maarufu',
    rangeTitle: 'Tunachosambaza',
    rangeIntro: 'Mahitaji ya kila siku kwa watumiaji wa simu na biashara.',
    rangeAsk: 'Tuulize WhatsApp',
    whoTitle: 'Tunaowahudumia',
    who: [
      {
        title: 'Wateja',
        text: 'Vifaa vya kuaminika kwa bei nzuri, pamoja na dhamana unayoweza kuitegemea.',
      },
      {
        title: 'Wauzaji wa rejareja na jumla',
        text: 'Upatikanaji wa uhakika wa vifaa vinavyouzika haraka kwa duka au mtandao wako wa usambazaji.',
      },
      {
        title: 'Vinyozi',
        text: 'Mashine za kunyolea na kupunguza nywele kwa matumizi ya kitaalamu kila siku.',
      },
    ],
    stockistTitle: 'Uza bidhaa za tai dukani kwako',
    stockistText:
      'Tunafanya kazi na wauzaji wa rejareja, wa jumla na wasambazaji Tanzania na Afrika Mashariki. Pata bei ya jumla kupitia WhatsApp.',
    founderQuote:
      'Maono yangu katika kuanzisha tai yalikuwa kujenga chapa inayoaminika, inayoleta ubora, uhakika na thamani katika vifaa vya simu na bidhaa za kielektroniki.',
    founderRole: 'Mwanzilishi, tai – Pride of Africa',
  },
}[lang]
---

<Base lang={lang} title={copy.title} description={copy.description} jsonLd={storeSchema(Astro.site!)}>
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="hero__intro">{copy.intro}</p>
      <div class="btn-row">
        <WhatsAppButton message={t(lang, 'wa.general')} label={t(lang, 'cta.whatsapp')} />
        <a class="btn btn--outline" href={localePath(lang, '/products/')}>
          {t(lang, 'cta.viewProducts')}
        </a>
      </div>
      <ul class="hero__trust">
        {copy.trust.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="featured-title">
    <div class="container">
      <h2 id="featured-title">{copy.featuredTitle}</h2>
      <div class="grid">
        {featured.map((product, i) => <ProductCard product={product} lang={lang} eager={i < 2} />)}
      </div>
      <p class="more">
        <a class="btn btn--outline" href={localePath(lang, '/products/')}>
          {t(lang, 'cta.viewProducts')}
        </a>
      </p>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="range-title">
    <div class="container">
      <h2 id="range-title">{copy.rangeTitle}</h2>
      <p class="lead">{copy.rangeIntro}</p>
      <ul class="range">
        {
          categories.map((category) => (
            <li>
              {categoriesWithProducts.has(category.id) ? (
                <a href={localePath(lang, `/products/#${category.id}`)}>{category[lang]}</a>
              ) : (
                <span>{category[lang]}</span>
              )}
            </li>
          ))
        }
      </ul>
      <WhatsAppButton message={t(lang, 'wa.general')} label={copy.rangeAsk} variant="lime" />
    </div>
  </section>

  <section class="section" aria-labelledby="who-title">
    <div class="container">
      <h2 id="who-title">{copy.whoTitle}</h2>
      <div class="grid">
        {
          copy.who.map((item) => (
            <div class="card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="stockist-title">
    <div class="container band__inner">
      <div>
        <h2 id="stockist-title">{copy.stockistTitle}</h2>
        <p>{copy.stockistText}</p>
      </div>
      <a class="btn btn--lime" href={localePath(lang, '/wholesale/')}>
        {t(lang, 'cta.becomeStockist')}
      </a>
    </div>
  </section>

  <section class="section" aria-label={copy.founderRole}>
    <div class="container">
      <figure class="quote">
        <blockquote>
          <p>“{copy.founderQuote}”</p>
        </blockquote>
        <figcaption><strong>{site.founder}</strong> · {copy.founderRole}</figcaption>
      </figure>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--hero-bg);
    color: var(--hero-text);
  }

  .hero__inner {
    padding-block: clamp(3rem, 10vw, 6rem);
  }

  .hero h1 {
    max-width: 14ch;
  }

  .hero__eyebrow {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.9rem;
  }

  .hero__intro {
    font-size: 1.2rem;
    max-width: 36rem;
    margin-bottom: 1.75rem;
  }

  .hero__trust {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-weight: 600;
  }

  .hero__trust li::before {
    content: '✓ ';
  }

  .more {
    margin-top: 1.5rem;
  }

  .range {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2rem;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }

  .range li > * {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 600;
  }

  .range a {
    text-decoration: none;
  }

  .range a::after {
    content: '→';
    margin-left: auto;
    color: var(--link);
  }

  .band {
    background: var(--band-bg);
    color: var(--band-text);
  }

  .band__inner {
    padding-block: clamp(2.5rem, 7vw, 4rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .band p {
    margin: 0;
    max-width: 40rem;
  }

  .quote {
    margin: 0;
    max-width: 48rem;
    border-left: 6px solid var(--lime);
    padding-left: 1.5rem;
  }

  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3.5vw, 1.8rem);
    line-height: 1.3;
  }

  .quote figcaption {
    color: var(--muted);
  }
</style>
