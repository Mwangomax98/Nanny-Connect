---
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'
import { localePath, t, type Lang } from '../lib/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<Base lang={lang} title={`${t(lang, 'notFound.title')} | tai`} description={t(lang, 'notFound.text')}>
  <PageHero eyebrow="404" title={t(lang, 'notFound.title')} intro={t(lang, 'notFound.text')}>
    <div class="btn-row">
      <WhatsAppButton message={t(lang, 'wa.general')} label={t(lang, 'cta.whatsapp')} variant="lime" />
      <a class="btn btn--outline" href={localePath(lang, '/products/')}>
        {t(lang, 'cta.viewProducts')}
      </a>
    </div>
  </PageHero>
</Base>
