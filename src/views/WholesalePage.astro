---
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'
import { site } from '../data/site'
import { t, type Lang } from '../lib/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const copy = {
  en: {
    title: 'Wholesale & stockists | tai – Pride of Africa',
    description:
      'Become a tai stockist. Wholesale supply of phone chargers, cables, batteries, memory cards and hair clippers for retailers, wholesalers, distributors and barbershops in East Africa.',
    heading: 'Become a tai stockist',
    intro:
      'We supply retailers, wholesalers, distributors and barbershops across Tanzania and East Africa with phone accessories and electronic essentials.',
    forTitle: 'Who we work with',
    for: [
      'Mobile phone accessory shops',
      'Wholesalers and distributors',
      'Barbershops and grooming professionals',
      'Businesses that need a reliable supply partner',
    ],
    whyTitle: 'Why stock tai',
    why: [
      ['A range that sells', 'Everyday essentials that mobile phone users need again and again.'],
      ['Value for money', 'A practical balance between quality, affordability and margin.'],
      ['A partner, not just a supplier', 'Responsive service and long-term relationships.'],
    ],
    stepsTitle: 'How it works',
    steps: [
      'Tap the WhatsApp button. A short message with the details we need opens for you.',
      'Fill in your business name, town, products and monthly quantity, then send.',
      'We reply with wholesale prices, stock and delivery options.',
    ],
    cta: 'Send wholesale enquiry',
    orEmail: 'Prefer email? Write to',
  },
  sw: {
    title: 'Jumla na wasambazaji | tai – Pride of Africa',
    description:
      'Kuwa msambazaji wa tai. Usambazaji wa jumla wa chaja, nyaya, betri, memory card na mashine za kunyolea kwa wauzaji, wasambazaji na vinyozi Afrika Mashariki.',
    heading: 'Kuwa msambazaji wa tai',
    intro:
      'Tunasambaza vifaa vya simu na bidhaa muhimu za kielektroniki kwa wauzaji wa rejareja, wa jumla, wasambazaji na vinyozi Tanzania na Afrika Mashariki.',
    forTitle: 'Tunafanya kazi na',
    for: [
      'Maduka ya vifaa vya simu',
      'Wauzaji wa jumla na wasambazaji',
      'Vinyozi na wataalamu wa urembo',
      'Biashara zinazohitaji mshirika wa usambazaji wa kuaminika',
    ],
    whyTitle: 'Kwa nini uuze tai',
    why: [
      ['Bidhaa zinazouzika', 'Mahitaji ya kila siku ambayo watumiaji wa simu huyanunua tena na tena.'],
      ['Thamani ya pesa', 'Uwiano mzuri kati ya ubora, bei nafuu na faida.'],
      ['Mshirika, si msambazaji tu', 'Huduma ya haraka na mahusiano ya muda mrefu.'],
    ],
    stepsTitle: 'Jinsi inavyofanya kazi',
    steps: [
      'Bonyeza kitufe cha WhatsApp. Ujumbe mfupi wenye taarifa tunazohitaji utafunguka.',
      'Jaza jina la biashara, mji, bidhaa na idadi kwa mwezi, kisha tuma.',
      'Tutakujibu na bei za jumla, upatikanaji wa bidhaa na njia za usafirishaji.',
    ],
    cta: 'Tuma ombi la jumla',
    orEmail: 'Unapendelea barua pepe? Tuandikie',
  },
}[lang]
---

<Base lang={lang} title={copy.title} description={copy.description}>
  <PageHero eyebrow={t(lang, 'nav.wholesale')} title={copy.heading} intro={copy.intro}>
    <WhatsAppButton message={t(lang, 'wa.wholesale')} label={copy.cta} variant="lime" />
  </PageHero>

  <section class="section" aria-labelledby="for-title">
    <div class="container">
      <h2 id="for-title">{copy.forTitle}</h2>
      <ul class="ticks">
        {copy.for.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--lime chevrons" aria-labelledby="why-title">
    <div class="container">
      <h2 id="why-title">{copy.whyTitle}</h2>
      <div class="grid why">
        {
          copy.why.map(([title, text]) => (
            <div class="card">
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="steps-title">
    <div class="container">
      <h2 id="steps-title">{copy.stepsTitle}</h2>
      <ol class="steps">
        {copy.steps.map((step) => <li>{step}</li>)}
      </ol>
      <WhatsAppButton message={t(lang, 'wa.wholesale')} label={copy.cta} />
      <p class="email">
        {copy.orEmail} <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .ticks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .ticks li {
    display: flex;
    align-items: center;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--border);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .ticks li::before {
    content: '✓';
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
    margin-right: 0.8rem;
    border-radius: 999px;
    background: var(--lime-bright);
    color: var(--ink);
    font-weight: 700;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    margin: 0 0 2.5rem;
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }

  .steps li {
    counter-increment: step;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    font-size: 1.1rem;
  }

  .steps li::before {
    content: counter(step);
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--lime-bright);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
  }

  .why :global(.card) {
    background: rgb(255 255 255 / 0.55);
  }

  .why h3 {
    font-size: 1.5rem;
  }

  .email {
    margin-top: 1.25rem;
    color: var(--muted);
  }
</style>
