---
import { Picture } from 'astro:assets'
import Base from '../layouts/Base.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'
import { categories, site } from '../data/site'
import { localePath, t, type Lang } from '../lib/i18n'
import { pick, productSlug, type Product } from '../lib/products'

interface Props {
  lang: Lang
  product: Product
}

const { lang, product } = Astro.props
const { code, name, summary, images, specs, inTheBox, warrantyDays, price, category } = product.data
const categoryName = categories.find((c) => c.id === category)?.[lang]
const pageUrl = new URL(localePath(lang, `/products/${productSlug(product)}/`), Astro.site).href
const waMessage = t(lang, 'wa.product', { code, name: name[lang], url: pageUrl })

const faqs = [
  { q: t(lang, 'product.faq.price.q'), a: t(lang, 'product.faq.price.a') },
  { q: t(lang, 'product.faq.delivery.q'), a: t(lang, 'product.faq.delivery.a') },
  { q: t(lang, 'product.faq.wholesale.q'), a: t(lang, 'product.faq.wholesale.a') },
]

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${name.en} (${code})`,
  sku: code,
  description: summary[lang],
  brand: { '@type': 'Brand', name: 'tai' },
  url: pageUrl,
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(lang, 'nav.products'),
      item: new URL(localePath(lang, '/products/'), Astro.site).href,
    },
    { '@type': 'ListItem', position: 2, name: name[lang], item: pageUrl },
  ],
}
---

<Base
  lang={lang}
  title={`${code} ${name[lang]} | tai`}
  description={summary[lang]}
  image={images[0]}
  jsonLd={[productSchema, breadcrumbSchema]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href={localePath(lang, '/products/')}>← {t(lang, 'product.back')}</a>
      {categoryName && <span> / {categoryName}</span>}
    </nav>

    <div class="layout">
      <div class="gallery">
        {
          images.map((img, i) => (
            <div class="gallery__photo">
              <Picture
                src={img}
                alt={i === 0 ? name[lang] : `${name[lang]} (${i + 1})`}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[400, 640, 960]}
                sizes="(min-width: 60rem) 34rem, 92vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
            </div>
          ))
        }
      </div>

      <div class="info">
        <p class="eyebrow">{t(lang, 'product.model')} {code}</p>
        <h1>{name[lang]}</h1>
        <p class="lead">{summary[lang]}</p>
        <p class="price">{price ?? t(lang, 'price.onRequest')}</p>
        <div class="btn-row">
          <WhatsAppButton message={waMessage} label={t(lang, 'cta.askPrice')} />
          <a class="btn btn--outline" href={`tel:${site.phone}`}>{t(lang, 'cta.call')}</a>
        </div>

        {
          specs.length > 0 && (
            <section aria-labelledby="specs-title">
              <h2 id="specs-title">{t(lang, 'product.specs')}</h2>
              <table class="specs">
                <tbody>
                  {specs.map((spec) => (
                    <tr>
                      <th scope="row">{spec[lang]}</th>
                      <td>{pick(lang, spec.value)}</td>
                    </tr>
                  ))}
                  {warrantyDays && (
                    <tr>
                      <th scope="row">{t(lang, 'product.warranty')}</th>
                      <td>{t(lang, 'product.warrantyDays', { days: warrantyDays })}</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </section>
          )
        }

        {
          inTheBox.length > 0 && (
            <section aria-labelledby="box-title">
              <h2 id="box-title">{t(lang, 'product.inTheBox')}</h2>
              <ul class="box">
                {inTheBox.map((item) => (
                  <li>{item[lang]}</li>
                ))}
              </ul>
            </section>
          )
        }

        <section aria-labelledby="faq-title">
          <h2 id="faq-title">{t(lang, 'product.faq')}</h2>
          {
            faqs.map((faq) => (
              <details class="faq">
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))
          }
        </section>
      </div>
    </div>
  </div>

  <div class="sticky-cta">
    <WhatsAppButton message={waMessage} label={t(lang, 'cta.askPrice')} variant="lime" />
  </div>
</Base>

<style>
  .breadcrumb {
    margin-bottom: 1.5rem;
    color: var(--muted);
  }

  .breadcrumb a {
    font-weight: 600;
  }

  .layout {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .gallery {
    display: grid;
    gap: 1rem;
  }

  .gallery__photo {
    background: var(--photo-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
  }

  .gallery__photo :global(img) {
    width: 100%;
    height: auto;
  }

  .info h2 {
    font-size: 1.35rem;
    margin-top: 2rem;
  }

  .price {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .specs {
    width: 100%;
    border-collapse: collapse;
  }

  .specs th,
  .specs td {
    text-align: left;
    padding: 0.65rem 0.5rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .specs th {
    width: 45%;
    color: var(--muted);
    font-weight: 600;
  }

  .box {
    padding-left: 1.25rem;
  }

  .faq {
    border-bottom: 1px solid var(--border);
  }

  .faq summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.9rem 0;
    min-height: 44px;
  }

  .faq p {
    color: var(--muted);
  }

  /* Always-visible WhatsApp button on phones. */
  .sticky-cta {
    position: sticky;
    bottom: 0;
    padding: 0.75rem 16px;
    background: var(--bg);
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: center;
  }

  .sticky-cta :global(.btn) {
    width: 100%;
    max-width: 28rem;
  }

  @media (min-width: 60rem) {
    .sticky-cta {
      display: none;
    }
  }
</style>
