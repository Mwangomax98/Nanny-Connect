---
import { Picture } from 'astro:assets'
import Base from '../layouts/Base.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'
import { categories, site } from '../data/site'
import { localePath, t, type Lang } from '../lib/i18n'
import { pick, productSlug, type Product } from '../lib/products'

interface Props {
  lang: Lang
  product: Product
}

const { lang, product } = Astro.props
const { code, name, summary, images, specs, inTheBox, warrantyDays, price, category } = product.data
const categoryName = categories.find((c) => c.id === category)?.[lang]
const pageUrl = new URL(localePath(lang, `/products/${productSlug(product)}/`), Astro.site).href
const waMessage = t(lang, 'wa.product', { code, name: name[lang], url: pageUrl })

const faqs = [
  { q: t(lang, 'product.faq.price.q'), a: t(lang, 'product.faq.price.a') },
  { q: t(lang, 'product.faq.delivery.q'), a: t(lang, 'product.faq.delivery.a') },
  { q: t(lang, 'product.faq.wholesale.q'), a: t(lang, 'product.faq.wholesale.a') },
]

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${name.en} (${code})`,
  sku: code,
  description: summary[lang],
  brand: { '@type': 'Brand', name: 'tai' },
  url: pageUrl,
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(lang, 'nav.products'),
      item: new URL(localePath(lang, '/products/'), Astro.site).href,
    },
    { '@type': 'ListItem', position: 2, name: name[lang], item: pageUrl },
  ],
}
---

<Base
  lang={lang}
  title={`${code} ${name[lang]} | tai`}
  description={summary[lang]}
  image={images[0]}
  jsonLd={[productSchema, breadcrumbSchema]}
>
  <section class="top">
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href={localePath(lang, '/products/')}>← {t(lang, 'product.back')}</a>
        {categoryName && <span aria-hidden="true">/</span>}
        {categoryName && <span>{categoryName}</span>}
      </nav>

      <div class="layout">
        <div class="gallery">
          {
            images.map((img, i) => (
              <div class="stage">
                <span class="eagle-mark stage__eagle" aria-hidden="true"></span>
                <div class="stage__photo">
                  <Picture
                    class="float-shadow"
                    src={img}
                    alt={i === 0 ? name[lang] : `${name[lang]} (${i + 1})`}
                    formats={['avif', 'webp']}
                    fallbackFormat="png"
                    widths={[400, 640, 960]}
                    sizes="(min-width: 60rem) 36rem, 92vw"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                  />
                </div>
              </div>
            ))
          }
        </div>

        <div class="info">
          <p class="code">{t(lang, 'product.model')} {code}</p>
          <h1>{name[lang]}</h1>
          <p class="lead">{summary[lang]}</p>
          <ul class="chips">
            <li class="chip chip--price">{price ?? t(lang, 'price.onRequest')}</li>
            {
              warrantyDays && (
                <li class="chip">
                  {t(lang, 'product.warranty')}: {t(lang, 'product.warrantyDays', { days: warrantyDays })}
                </li>
              )
            }
          </ul>
          <div class="btn-row">
            <WhatsAppButton message={waMessage} label={t(lang, 'cta.askPrice')} variant="lime" />
            <a class="btn btn--outline" href={`tel:${site.phone}`}>{t(lang, 'cta.call')}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container details">
      {
        specs.length > 0 && (
          <section class="panel" aria-labelledby="specs-title">
            <h2 id="specs-title">{t(lang, 'product.specs')}</h2>
            <table class="specs">
              <tbody>
                {specs.map((spec) => (
                  <tr>
                    <th scope="row">{spec[lang]}</th>
                    <td>{pick(lang, spec.value)}</td>
                  </tr>
                ))}
                {warrantyDays && (
                  <tr>
                    <th scope="row">{t(lang, 'product.warranty')}</th>
                    <td>{t(lang, 'product.warrantyDays', { days: warrantyDays })}</td>
                  </tr>
                )}
              </tbody>
            </table>
          </section>
        )
      }

      <div class="side">
        {
          inTheBox.length > 0 && (
            <section class="panel" aria-labelledby="box-title">
              <h2 id="box-title">{t(lang, 'product.inTheBox')}</h2>
              <ul class="box">
                {inTheBox.map((item) => (
                  <li>{item[lang]}</li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="panel" aria-labelledby="faq-title">
          <h2 id="faq-title">{t(lang, 'product.faq')}</h2>
          {
            faqs.map((faq) => (
              <details class="faq">
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))
          }
        </section>
      </div>
    </div>
  </section>

  <div class="sticky-cta">
    <WhatsAppButton message={waMessage} label={t(lang, 'cta.askPrice')} variant="lime" />
  </div>
</Base>

<style>
  .top {
    background: var(--ink);
    color: var(--white);
    --text: var(--white);
    --muted: #b9cbb0;
    --link: var(--lime-bright);
    --focus: var(--amber);
    padding-block: 1.5rem clamp(3rem, 8vw, 5rem);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    color: var(--muted);
    font-weight: 600;
  }

  .breadcrumb a {
    color: var(--lime-bright);
    text-decoration: none;
  }

  .layout {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: 1.05fr 1fr;
      align-items: center;
      gap: 4rem;
    }
  }

  .gallery {
    display: grid;
    gap: 1rem;
  }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(320px, 70vw, 560px);
    border-radius: 28px;
    background:
      radial-gradient(circle at 50% 50%, rgb(142 224 0 / 0.35) 0%, transparent 60%),
      #10240b;
    border: 1px solid #24401b;
    padding: clamp(1.5rem, 6vw, 3rem);
    overflow: hidden;
  }

  .stage__eagle {
    width: 80%;
    left: 10%;
    top: 12%;
    color: var(--lime-bright);
    opacity: 0.08;
  }

  .stage__photo {
    position: relative;
    width: min(100%, 22rem);
    transform: rotate(-3deg);
  }

  .stage__photo :global(img) {
    width: 100%;
    height: auto;
  }

  .code {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--lime-bright);
    color: var(--ink);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .info h1 {
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    margin-top: 0.75rem;
  }

  .chips {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .chip {
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid #2c4a22;
    font-weight: 700;
  }

  .chip--price {
    background: var(--white);
    color: var(--ink);
    border-color: var(--white);
  }

  .details {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 60rem) {
    .details {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .side {
    display: grid;
    gap: 1.5rem;
  }

  .panel {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(1.4rem, 4vw, 2rem);
  }

  .panel h2 {
    font-size: 1.7rem;
    margin-bottom: 1rem;
  }

  .specs {
    width: 100%;
    border-collapse: collapse;
  }

  .specs th,
  .specs td {
    text-align: left;
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .specs tr:last-child th,
  .specs tr:last-child td {
    border-bottom: 0;
  }

  .specs th {
    width: 45%;
    color: var(--muted);
    font-weight: 600;
  }

  .specs td {
    font-weight: 700;
  }

  .box {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .box li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    font-weight: 600;
  }

  .box li::before {
    content: '✓';
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--lime-bright);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .faq {
    border-bottom: 1px solid var(--border);
  }

  .faq:last-child {
    border-bottom: 0;
  }

  .faq summary {
    cursor: pointer;
    font-weight: 700;
    padding: 0.9rem 0;
    min-height: 44px;
  }

  .faq p {
    color: var(--muted);
  }

  /* Always-visible WhatsApp button on phones. */
  .sticky-cta {
    position: sticky;
    bottom: 0;
    z-index: 30;
    padding: 0.75rem 16px;
    background: rgb(9 22 6 / 0.94);
    backdrop-filter: blur(10px);
    display: flex;
    justify-content: center;
  }

  .sticky-cta :global(.btn) {
    width: 100%;
    max-width: 28rem;
  }

  @media (min-width: 60rem) {
    .sticky-cta {
      display: none;
    }
  }
</style>
