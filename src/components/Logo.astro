---
// Text logo until the official SVG logo files arrive.
interface Props {
  href: string
}

const { href } = Astro.props
---

<a class="logo" href={href} aria-label="tai – Pride of Africa">
  <span class="logo__mark">tai</span>
  <span class="logo__tag">Pride of Africa</span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    text-decoration: none;
    color: var(--text);
  }

  .logo__mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    letter-spacing: -0.03em;
  }

  .logo__tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
