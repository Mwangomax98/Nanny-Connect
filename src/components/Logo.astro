---
// Wordmark until the official SVG logo files arrive.
interface Props {
  href: string
}

const { href } = Astro.props
---

<a class="logo" href={href} aria-label="tai – Pride of Africa">
  <span class="logo__mark" aria-hidden="true">ta<span class="logo__i">i</span></span>
  <span class="logo__tag" aria-hidden="true">Pride of Africa</span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    text-decoration: none;
    color: var(--white);
  }

  .logo__mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.2rem;
    letter-spacing: -0.05em;
  }

  .logo__i {
    color: var(--lime-bright);
  }

  .logo__tag {
    margin-top: 2px;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lime-bright);
  }
</style>
