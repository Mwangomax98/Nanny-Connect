---
// Official tai logo (green eagle + wordmark, transparent background).
interface Props {
  href: string
  height?: number
}

const { href, height = 58 } = Astro.props
const width = Math.round((791 / 363) * height)
---

<a class="logo" href={href}>
  <img src="/logo.png" alt="tai – Pride of Africa" width={width} height={height} />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    padding-block: 2px;
  }

  .logo img {
    display: block;
  }
</style>
