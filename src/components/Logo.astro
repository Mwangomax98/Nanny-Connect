---
// tai eagle logo (white version, taken from the packaging until the official files arrive).
interface Props {
  href: string
  height?: number
}

const { href, height = 46 } = Astro.props
const width = Math.round((256 / 105) * height)
---

<a class="logo" href={href}>
  <img src="/logo-white.png" alt="tai – Pride of Africa" width={width} height={height} />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    padding-block: 4px;
  }

  .logo img {
    display: block;
  }
</style>
