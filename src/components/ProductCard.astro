---
import { Picture } from 'astro:assets'
import { localePath, t, type Lang } from '../lib/i18n'
import { keySpecs, productSlug, searchText, type Product } from '../lib/products'

interface Props {
  product: Product
  lang: Lang
  /** Load the photo straight away (use for cards visible without scrolling). */
  eager?: boolean
}

const { product, lang, eager = false } = Astro.props
const { code, name, summary, images, price } = product.data
const href = localePath(lang, `/products/${productSlug(product)}/`)
const chips = keySpecs(product, lang)
---

<article class="product-card" data-reveal data-product-card data-category={product.data.category} data-search={searchText(product)}>
  <div class="product-card__photo">
    <span class="product-card__code">{code}</span>
    <Picture
      class="float-shadow"
      src={images[0]}
      alt={name[lang]}
      formats={['avif', 'webp']}
      fallbackFormat="png"
      widths={[320, 480, 640]}
      sizes="(min-width: 76rem) 24rem, (min-width: 40rem) 45vw, 92vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </div>
  <div class="product-card__body">
    <h3 class="product-card__name">
      <a href={href}>{name[lang]}</a>
    </h3>
    {
      chips.length > 0 && (
        <ul class="product-card__chips">
          {chips.map((chip) => (
            <li>{chip}</li>
          ))}
        </ul>
      )
    }
    <p class="product-card__summary">{summary[lang]}</p>
    <div class="product-card__foot">
      <span>{price ?? t(lang, 'price.onRequest')}</span>
      <button
        type="button"
        class="add-btn"
        data-add-to-list
        data-id={productSlug(product)}
        data-code={code}
        data-name-en={name.en}
        data-name-sw={name.sw}
        aria-label={`${t(lang, 'list.addLong')}: ${code} ${name[lang]}`}
      >
        <span class="add-btn__icon" aria-hidden="true">+</span>
        <span data-add-label>{t(lang, 'list.add')}</span>
      </button>
    </div>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .product-card[hidden] {
    display: none;
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: var(--lime);
  }

  .product-card:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .product-card__photo {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    padding: 1.75rem 1.5rem 1.25rem;
    background:
      radial-gradient(circle at 50% 55%, rgb(142 224 0 / 0.28) 0%, transparent 55%),
      repeating-linear-gradient(-55deg, rgb(142 224 0 / 0.05) 0 40px, transparent 40px 80px),
      var(--ink);
    overflow: hidden;
  }

  .product-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card__photo :global(img) {
    transform: scale(1.06) rotate(-2deg);
  }

  .product-card__code {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    z-index: 1;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--lime-bright);
    color: var(--ink);
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.35rem 1.35rem;
  }

  .product-card__name {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }

  /* The whole card is clickable through the name link. */
  .product-card__name a {
    color: var(--text);
    text-decoration: none;
  }

  .product-card__name a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .product-card__name a:focus-visible {
    outline: none;
  }

  .product-card__chips {
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .product-card__chips li {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .product-card__chips li:first-child {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--lime-bright);
  }

  .product-card__summary {
    font-size: 0.95rem;
    color: var(--muted);
  }

  .product-card__foot {
    margin: auto 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    font-weight: 700;
  }

  /* Sits above the card-wide link so it can be clicked on its own. */
  .add-btn {
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 0.95rem 0 0.4rem;
    border-radius: 999px;
    border: 0;
    background: var(--lime-bright);
    color: var(--ink);
    font: inherit;
    font-weight: 800;
    font-size: 0.92rem;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .add-btn:hover {
    transform: translateY(-2px);
  }

  .add-btn__icon {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--lime-bright);
    font-size: 1.15rem;
    line-height: 1;
  }

  .add-btn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--lime-bright);
  }

  .add-btn[aria-pressed='true'] .add-btn__icon {
    background: var(--lime-bright);
    color: var(--ink);
  }
</style>
