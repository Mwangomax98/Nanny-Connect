---
import { Picture } from 'astro:assets'
import { localePath, t, type Lang } from '../lib/i18n'
import { productSlug, type Product } from '../lib/products'

interface Props {
  product: Product
  lang: Lang
  /** Load the photo straight away (use for cards visible without scrolling). */
  eager?: boolean
}

const { product, lang, eager = false } = Astro.props
const { code, name, summary, images, price } = product.data
const href = localePath(lang, `/products/${productSlug(product)}/`)
---

<article class="product-card">
  <div class="product-card__photo">
    <span class="product-card__code">{code}</span>
    <Picture
      src={images[0]}
      alt={name[lang]}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[320, 480, 640]}
      sizes="(min-width: 76rem) 24rem, (min-width: 40rem) 45vw, 92vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </div>
  <div class="product-card__body">
    <h3 class="product-card__name">
      <a href={href}>{name[lang]}</a>
    </h3>
    <p class="product-card__summary">{summary[lang]}</p>
    <p class="product-card__foot">
      <span>{price ?? t(lang, 'price.onRequest')}</span>
      <span class="product-card__arrow" aria-hidden="true">→</span>
    </p>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: var(--lime);
  }

  .product-card:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .product-card__photo {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    background: radial-gradient(circle at 50% 60%, #ffffff 0 45%, #eef6e3 100%);
  }

  .product-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card__photo :global(img) {
    transform: scale(1.04);
  }

  .product-card__code {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    z-index: 1;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--lime-bright);
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.35rem 1.35rem;
  }

  .product-card__name {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }

  /* The whole card is clickable through the name link. */
  .product-card__name a {
    color: var(--text);
    text-decoration: none;
  }

  .product-card__name a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .product-card__name a:focus-visible {
    outline: none;
  }

  .product-card__summary {
    font-size: 0.95rem;
    color: var(--muted);
  }

  .product-card__foot {
    margin: auto 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 700;
  }

  .product-card__arrow {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--lime-bright);
    color: var(--ink);
    font-size: 1.2rem;
    transition: transform 0.2s ease;
  }

  .product-card:hover .product-card__arrow {
    transform: translateX(4px);
  }
</style>
