---
import '@fontsource-variable/bricolage-grotesque/wght.css'
import '@fontsource-variable/dm-sans/wght.css'
import '../styles/global.css'

import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { alternatePath, t, type Lang } from '../lib/i18n'

interface Props {
  lang: Lang
  title: string
  description: string
  /** Picture shown when the page is shared on WhatsApp or social media. */
  image?: ImageMetadata
  /** Structured data for Google (schema.org). */
  jsonLd?: object | object[]
}

const { lang, title, description, image, jsonLd } = Astro.props
const pathname = Astro.url.pathname
const site = Astro.site!
const canonical = new URL(pathname, site).href
const enUrl = new URL(lang === 'en' ? pathname : alternatePath(lang, pathname), site).href
const swUrl = new URL(lang === 'sw' ? pathname : alternatePath(lang, pathname), site).href

// WhatsApp previews need an absolute JPEG URL.
const shareImage = image
  ? new URL((await getImage({ src: image, width: 1200, format: 'jpeg', quality: 80 })).src, site)
      .href
  : new URL('/og-default.jpg', site).href
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="sw" href={swUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#5cb800" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="tai – Pride of Africa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'sw_TZ'} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    <!-- Apply the saved light/dark choice before the page paints. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme')
        if (saved) document.documentElement.dataset.theme = saved
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'nav.skip')}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement
        const isDark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches)
        const next = isDark ? 'light' : 'dark'
        root.dataset.theme = next
        try {
          localStorage.setItem('theme', next)
        } catch {}
      })
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main:focus {
    outline: none;
  }
</style>
